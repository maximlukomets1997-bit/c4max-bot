# --- Секреты: НИКОГДА не коммитить ---
.env
*.env
!.env.example

# --- Данные пользователей ---
history.db
*.sqlite
*.sqlite3

# --- Служебные файлы SQLite: у любой базы, включая заготовку seed.db ---
*.db-shm
*.db-wal
*.db-journal

# --- Служебные файлы запуска ---
bot.pid
bot.alive

# --- Метка сборки (2026-07-31) ---
# Короткий номер коммита, который лежит на сервере: его пишет туда deploy.sh
# при каждом обновлении, а панель /adm показывает рядом с номером версии.
# Файл принадлежит машине, а не коду: приехав через GitHub, он врал бы о том,
# какая сборка работает (та же причина, что у указателя базы знаний ниже).
.build
watchdog.state
watchdog.log

# --- Указатель базы знаний: каждая машина строит его себе сама ---
# Бот перезаписывает этот файл у себя при каждой пересборке базы. Пока он
# ездил через GitHub, обновление сервера рисковало намертво упереться в
# «файл изменён и там, и тут» (2026-07-27). Плюс приехавший чужой указатель
# заставлял бота переиндексировать все 80 статей заново — это минуты молчания
# и расход бесплатной квоты Google.
knowledge/knowledge_base_vectors.json

# --- Копии базы (2026-07-31) ---
# Ночные копии history.db. В репозиторий им нельзя ровно по той же причине,
# что и самой базе: это переписка живых людей, их личные дела и ключи-остатки.
backups/

# --- Логи ---
logs/
*.log

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# --- Редакторы и ОС ---
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# --- Локальные настройки Claude Code ---
.claude/settings.local.json

# --- Папки-пульты: кнопки только для этого ПК, на сервере бесполезны ---
Для запуска на ПК/
Для гитрепозитория/
