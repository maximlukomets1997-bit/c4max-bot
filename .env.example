# Шаблон переменных окружения. Скопировать в .env и вписать свои значения.
# Файл .env в git не попадает (см. .gitignore) — ключи храним только локально.

# --- Обязательное ---
TELEGRAM_TOKEN=          # токен бота от @BotFather
GEMINI_API_KEY=          # основная модель

# --- Дополнительные модели (можно оставить пустыми) ---
GEMINI_IMAGEN_API_KEY=   # если пусто — берётся GEMINI_API_KEY
QWEN_API_KEY=
DEEPSEEK_API_KEY=
XIAOMI_API_KEY=

# --- База знаний (RAG) ---
RAG_ENABLED=true
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.58
RAG_CHUNK_MODE=file
RAG_LEX_BOOST=0.10
RAG_PEAK_MARGIN=0.14
RAG_STRONG_SIM=0.70

# --- Веб-админка (сайт) ---
# Сайт живёт внутри процесса бота и слушает только 127.0.0.1; наружу его
# выводит Caddy с HTTPS. Дома обычно не нужен — по умолчанию выключен.
WEB_ENABLED=false
# Полный адрес снаружи, БЕЗ косой черты на конце. Пусто → кнопка «🌐 Админка»
# в панели /adm не появляется и вход через браузер не работает.
WEB_PUBLIC_URL=
# Менять почти никогда не нужно. ⚠️ WEB_HOST=0.0.0.0 откроет сайт в интернет
# по голому HTTP, мимо Caddy — так делать нельзя.
# WEB_HOST=127.0.0.1
# WEB_PORT=8080

# --- Прочее ---
# Адрес отметки healthchecks.io — внешний сторож. Единственный, кто заметит
# смерть всей машины. У КАЖДОГО бота должен быть СВОЙ адрес: с общим они
# прикрывают друг друга, и тревога не придёт ни за одного.
WATCHDOG_URL=

# Кто управляет процессом бота. Задавать вручную обычно НЕ нужно: на Windows
# по умолчанию false (бот сам за себя), на Linux и хостингах — true
# (перезапуском занимается панель). Подробности — в config.py.
# IS_DOCKER=
